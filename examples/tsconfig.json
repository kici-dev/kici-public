{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true
  },
  "include": [
    "workflows/**/*.ts",
    "dynamic-context/.kici/**/*.ts",
    "github-actions-autoscale/**/*.ts",
    "hetzner-autoscale/**/*.ts"
  ]
}
