{
  "name": "@kici-dev/engine",
  "version": "0.6.1",
  "description": "Shared business logic for the KiCI CI/CD stack: protocol, triggers, state machine, and provider interfaces used by the Platform relay, orchestrator, and compiler.",
  "keywords": [
    "ci",
    "cicd",
    "continuous-integration",
    "typescript",
    "workflow",
    "engine"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kici-dev/kici-public.git",
    "directory": "packages/engine"
  },
  "bugs": "https://github.com/kici-dev/kici-public/issues",
  "homepage": "https://kici.dev",
  "author": {
    "name": "KiCI",
    "email": "hello@kici.dev"
  },
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "files": [
    "dist",
    "!dist/**/*.map",
    "sbom.spdx.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./trigger/trigger-event-type": {
      "import": "./dist/trigger/trigger-event-type.js",
      "types": "./dist/trigger/trigger-event-type.d.ts"
    },
    "./trigger/content-requirements": {
      "import": "./dist/trigger/content-requirements.js",
      "types": "./dist/trigger/content-requirements.d.ts"
    },
    "./webhook/signature": {
      "import": "./dist/webhook/signature.js",
      "types": "./dist/webhook/signature.d.ts"
    },
    "./scaler/registry-auth": {
      "import": "./dist/scaler/registry-auth.js",
      "types": "./dist/scaler/registry-auth.d.ts"
    },
    "./safe-regex": {
      "import": "./dist/safe-regex.js",
      "types": "./dist/safe-regex.d.ts"
    },
    "./labels/compile": {
      "import": "./dist/labels/compile.js",
      "types": "./dist/labels/compile.d.ts"
    },
    "./context/host-match": {
      "import": "./dist/context/host-match.js",
      "types": "./dist/context/host-match.d.ts"
    },
    "./context/scope-template": {
      "import": "./dist/context/scope-template.js",
      "types": "./dist/context/scope-template.d.ts"
    },
    "./protocol/dashboard-global-workflows": {
      "import": "./dist/protocol/dashboard-global-workflows.js",
      "types": "./dist/protocol/dashboard-global-workflows.d.ts"
    },
    "./protocol/dashboard-write-operations": {
      "import": "./dist/protocol/dashboard-write-operations.js",
      "types": "./dist/protocol/dashboard-write-operations.d.ts"
    },
    "./protocol/dashboard-api-errors": {
      "import": "./dist/protocol/dashboard-api-errors.js",
      "types": "./dist/protocol/dashboard-api-errors.d.ts"
    },
    "./protocol/session-policy": {
      "import": "./dist/protocol/session-policy.js",
      "types": "./dist/protocol/session-policy.d.ts"
    },
    "./protocol/analytics-events": {
      "import": "./dist/protocol/analytics-events.js",
      "types": "./dist/protocol/analytics-events.d.ts"
    },
    "./protocol/cluster-name": {
      "import": "./dist/protocol/cluster-name.js",
      "types": "./dist/protocol/cluster-name.d.ts"
    },
    "./protocol/messages/oidc-token-relay": {
      "import": "./dist/protocol/messages/oidc-token-relay.js",
      "types": "./dist/protocol/messages/oidc-token-relay.d.ts"
    },
    "./protocol/messages/dashboard-sealed-write": {
      "import": "./dist/protocol/messages/dashboard-sealed-write.js",
      "types": "./dist/protocol/messages/dashboard-sealed-write.d.ts"
    },
    "./protocol/messages/oidc-mint": {
      "import": "./dist/protocol/messages/oidc-mint.js",
      "types": "./dist/protocol/messages/oidc-mint.d.ts"
    },
    "./protocol/messages/git-credential-relay": {
      "import": "./dist/protocol/messages/git-credential-relay.js",
      "types": "./dist/protocol/messages/git-credential-relay.d.ts"
    },
    "./provenance/schema": {
      "import": "./dist/provenance/schema.js",
      "types": "./dist/provenance/schema.d.ts"
    },
    "./provenance/dsse": {
      "import": "./dist/provenance/dsse.js",
      "types": "./dist/provenance/dsse.d.ts"
    },
    "./provenance/bundle": {
      "import": "./dist/provenance/bundle.js",
      "types": "./dist/provenance/bundle.d.ts"
    },
    "./provenance/verify": {
      "import": "./dist/provenance/verify.js",
      "types": "./dist/provenance/verify.d.ts"
    },
    "./provenance/statement-hash": {
      "import": "./dist/provenance/statement-hash.js",
      "types": "./dist/provenance/statement-hash.d.ts"
    },
    "./metrics/catalog": {
      "import": "./dist/metrics/metric-catalog.generated.js",
      "types": "./dist/metrics/metric-catalog.generated.d.ts"
    },
    "./metrics/catalog-policy": {
      "import": "./dist/metrics/catalog-policy.js",
      "types": "./dist/metrics/catalog-policy.d.ts"
    },
    "./metrics/metric-kind-compat": {
      "import": "./dist/metrics/metric-kind-compat.js",
      "types": "./dist/metrics/metric-kind-compat.d.ts"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-ts.mjs && tsgo --emitDeclarationOnly",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run",
    "prepack": "pnpm exec tsx ../../hack/generate-sbom.ts --package packages/engine --name @kici-dev/engine"
  },
  "dependencies": {
    "jose": "^6.2.10",
    "jsonpath-plus": "^10.4.0",
    "picomatch": "^4.0.7",
    "safe-regex": "^2.1.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "@types/safe-regex": "^1.1.6"
  }
}
