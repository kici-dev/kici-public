exports[`org-settings help pin > org-settings dashboard-writes --help is unchanged 1`] = `
"Usage: kici-admin org-settings dashboard-writes [options] [command]

Manage per-orch dashboard write policy (which Platform-routed dashboard.* writes the orch accepts)

Options:
  -h, --help       display help for command

Commands:
  show [options]   Print current dashboard-write policy. Empty = all enabled.
  set [options]    Set one or more operations. Use --op <name>=<permissive|encrypted|disabled> per
                   operation. "encrypted" is valid only for plaintext operations (secrets.set,
                   variables.set). Sugar: --category or --sensitivity + --enabled <bool> expands to
                   the matching operations.
  reset [options]  Reset all operations to enabled (permissive default).
  help [command]   display help for command
"
`;

exports[`org-settings help pin > org-settings dashboard-writes reset --help is unchanged 1`] = `
"Usage: kici-admin org-settings dashboard-writes reset [options]

Reset all operations to enabled (permissive default).

Options:
  --org <id>         Org id
  --format <format>  Output format: json|table (default: "table")
  -h, --help         display help for command
"
`;

exports[`org-settings help pin > org-settings dashboard-writes set --help is unchanged 1`] = `
"Usage: kici-admin org-settings dashboard-writes set [options]

Set one or more operations. Use --op <name>=<permissive|encrypted|disabled> per operation.
"encrypted" is valid only for plaintext operations (secrets.set, variables.set). Sugar: --category
or --sensitivity + --enabled <bool> expands to the matching operations.

Options:
  --org <id>            Org id
  --op <op=state>       Single operation posture; repeatable (e.g. --op secrets.set=encrypted --op
                        variables.set=disabled) (default: [])
  --category <name>     Apply --enabled to every operation in this category
  --sensitivity <name>  Apply --enabled to every operation in this sensitivity bucket
  --enabled <bool>      Pair with --category or --sensitivity to flip the whole group
  --format <format>     Output format: json|table (default: "table")
  -h, --help            display help for command
"
`;

exports[`org-settings help pin > org-settings dashboard-writes show --help is unchanged 1`] = `
"Usage: kici-admin org-settings dashboard-writes show [options]

Print current dashboard-write policy. Empty = all enabled.

Options:
  --org <id>            Org id
  --category <name>     Filter to one category (Secrets|Variables|Environments|Bindings|"Held
                        runs"|DLQ|Registrations|Topology)
  --sensitivity <name>  Filter to one sensitivity bucket (plaintext|authority|dispatch)
  --format <format>     Output format: json|table (default: "table")
  -h, --help            display help for command
"
`;

