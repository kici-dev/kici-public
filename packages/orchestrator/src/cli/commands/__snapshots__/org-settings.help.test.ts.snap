exports[`org-settings help pin > keeps the full command tree unchanged 1`] = `
"org-settings :: Manage org-level security settings
  global-workflows :: Manage per-org global workflow policy
    show :: Print current global workflow settings for an org
      --org <id> mandatory=true :: Org id
      --format <format> mandatory=false default=table :: Output format: json|table
    allow-add :: Add a glob pattern to the workflow-author allow-list. Use --source to qualify the entry to one webhook source.
      arg pattern required=true :: 
      --org <id> mandatory=true :: Org id
      --source <routingKey> mandatory=false :: Pin the entry to one webhook source (e.g. github:42). Omit for any source.
      --format <format> mandatory=false default=table :: Output format: json|table
    allow-remove :: Remove a glob pattern from the workflow-author allow-list. Use --source to target a source-qualified entry.
      arg pattern required=true :: 
      --org <id> mandatory=true :: Org id
      --source <routingKey> mandatory=false :: Match an entry pinned to this routing key. Omit to match an unqualified entry.
      --format <format> mandatory=false default=table :: Output format: json|table
    deny-add :: Add a glob pattern to the source-repo deny-list. Use --source to qualify the entry to one webhook source.
      arg pattern required=true :: 
      --org <id> mandatory=true :: Org id
      --source <routingKey> mandatory=false :: Pin the entry to one webhook source (e.g. github:42). Omit for any source.
      --format <format> mandatory=false default=table :: Output format: json|table
    deny-remove :: Remove a glob pattern from the source-repo deny-list. Use --source to target a source-qualified entry.
      arg pattern required=true :: 
      --org <id> mandatory=true :: Org id
      --source <routingKey> mandatory=false :: Match an entry pinned to this routing key. Omit to match an unqualified entry.
      --format <format> mandatory=false default=table :: Output format: json|table
  dashboard-writes :: Manage per-orch dashboard write policy (which Platform-routed dashboard.* writes the orch accepts)
    show :: Print current dashboard-write policy. Empty = all enabled.
      --org <id> mandatory=true :: Org id
      --category <name> mandatory=false :: Filter to one category (Secrets|Variables|Environments|Bindings|"Held runs"|DLQ|Registrations|Topology)
      --sensitivity <name> mandatory=false :: Filter to one sensitivity bucket (plaintext|authority|dispatch)
      --format <format> mandatory=false default=table :: Output format: json|table
    set :: Set one or more operations. Use --op <name>=<permissive|encrypted|disabled> per operation. "encrypted" is valid only for plaintext operations (secrets.set, variables.set). Sugar: --category or --sensitivity + --enabled <bool> expands to the matching operations.
      --org <id> mandatory=true :: Org id
      --op <op=state> mandatory=false default= :: Single operation posture; repeatable (e.g. --op secrets.set=encrypted --op variables.set=disabled)
      --category <name> mandatory=false :: Apply --enabled to every operation in this category
      --sensitivity <name> mandatory=false :: Apply --enabled to every operation in this sensitivity bucket
      --enabled <bool> mandatory=false :: Pair with --category or --sensitivity to flip the whole group
      --format <format> mandatory=false default=table :: Output format: json|table
    reset :: Reset all operations to enabled (permissive default).
      --org <id> mandatory=true :: Org id
      --format <format> mandatory=false default=table :: Output format: json|table
  allow-http-npm :: Permit plain http:// npm registry URLs in workflow registries:. Default false; loopback / *.local are always allowed regardless.
    arg value required=true :: 
    --org <id> mandatory=true :: Org id
    --format <format> mandatory=false default=table :: Output format: json|table
  allow-untrusted-dockerfile-builds :: Permit an untrusted ref (fork PR) to build a job's container image from a Dockerfile. Default false. The build is NOT sandboxed — it runs arbitrary RUN commands on the agent host's container daemon.
    arg value required=true :: 
    --org <id> mandatory=true :: Org id
    --format <format> mandatory=false default=table :: Output format: json|table
  user-cache :: Manage per-org user-facing cache quota + entry TTL (null = cluster default)
    show :: Print the current per-org user-cache quota + TTL settings
      --org <id> mandatory=true :: Org id
      --format <format> mandatory=false default=table :: Output format: json|table
    set-quota :: Set the per-org user-cache quota (positive integer bytes)
      arg value required=true :: 
      --org <id> mandatory=true :: Org id
      --format <format> mandatory=false default=table :: Output format: json|table
    reset-quota :: Clear the per-org user-cache quota override (fall back to the cluster default)
      --org <id> mandatory=true :: Org id
      --format <format> mandatory=false default=table :: Output format: json|table
    set-ttl :: Set the per-org user-cache ttl (positive integer milliseconds)
      arg value required=true :: 
      --org <id> mandatory=true :: Org id
      --format <format> mandatory=false default=table :: Output format: json|table
    reset-ttl :: Clear the per-org user-cache ttl override (fall back to the cluster default)
      --org <id> mandatory=true :: Org id
      --format <format> mandatory=false default=table :: Output format: json|table
  artifacts :: Manage per-org artifact quota / TTL / size cap / per-run cap (null = cluster default)
    show :: Print the current per-org artifact quota + TTL settings
      --org <id> mandatory=true :: Org id
      --format <format> mandatory=false default=table :: Output format: json|table
    set-quota :: Set the per-org artifact quota (positive integer bytes)
      arg value required=true :: 
      --org <id> mandatory=true :: Org id
      --format <format> mandatory=false default=table :: Output format: json|table
    reset-quota :: Clear the per-org artifact quota override (fall back to the cluster default)
      --org <id> mandatory=true :: Org id
      --format <format> mandatory=false default=table :: Output format: json|table
    set-ttl :: Set the per-org artifact ttl (positive integer milliseconds)
      arg value required=true :: 
      --org <id> mandatory=true :: Org id
      --format <format> mandatory=false default=table :: Output format: json|table
    reset-ttl :: Clear the per-org artifact ttl override (fall back to the cluster default)
      --org <id> mandatory=true :: Org id
      --format <format> mandatory=false default=table :: Output format: json|table
    set-max-bytes :: Set the per-org artifact max-bytes (positive integer bytes)
      arg value required=true :: 
      --org <id> mandatory=true :: Org id
      --format <format> mandatory=false default=table :: Output format: json|table
    reset-max-bytes :: Clear the per-org artifact max-bytes override (fall back to the cluster default)
      --org <id> mandatory=true :: Org id
      --format <format> mandatory=false default=table :: Output format: json|table
    set-max-per-run :: Set the per-org artifact max-per-run (positive integer artifacts)
      arg value required=true :: 
      --org <id> mandatory=true :: Org id
      --format <format> mandatory=false default=table :: Output format: json|table
    reset-max-per-run :: Clear the per-org artifact max-per-run override (fall back to the cluster default)
      --org <id> mandatory=true :: Org id
      --format <format> mandatory=false default=table :: Output format: json|table
  dispatch-ack :: Manage the per-org dispatch-acknowledgment deadline (null = cluster default)
    show :: Print the current per-org dispatch-acknowledgment deadline
      --org <id> mandatory=true :: Org id
      --format <format> mandatory=false default=table :: Output format: json|table
    set :: Set the per-org dispatch-acknowledgment deadline (integer milliseconds, >= 1000)
      arg value required=true :: 
      --org <id> mandatory=true :: Org id
      --format <format> mandatory=false default=table :: Output format: json|table
    reset :: Clear the per-org dispatch-ack deadline override (fall back to the cluster default)
      --org <id> mandatory=true :: Org id
      --format <format> mandatory=false default=table :: Output format: json|table
  scaler-spawn-timeout :: Manage the per-org scaler spawn deadline (null = cluster default)
    show :: Print the current per-org scaler spawn deadline
      --org <id> mandatory=true :: Org id
      --format <format> mandatory=false default=table :: Output format: json|table
    set :: Set the per-org scaler spawn deadline (integer milliseconds, >= 1000)
      arg value required=true :: 
      --org <id> mandatory=true :: Org id
      --format <format> mandatory=false default=table :: Output format: json|table
    reset :: Clear the per-org scaler spawn deadline override (fall back to the cluster default)
      --org <id> mandatory=true :: Org id
      --format <format> mandatory=false default=table :: Output format: json|table
  ingest-concurrency :: Manage the per-org webhook-ingest concurrency cap (null = cluster default)
    show :: Print the current per-org webhook-ingest concurrency cap
      --org <id> mandatory=true :: Org id
      --format <format> mandatory=false default=table :: Output format: json|table
    set :: Set the per-org webhook-ingest concurrency cap (integer, >= 1)
      arg value required=true :: 
      --org <id> mandatory=true :: Org id
      --format <format> mandatory=false default=table :: Output format: json|table
    reset :: Clear the per-org webhook-ingest concurrency override (fall back to the cluster default)
      --org <id> mandatory=true :: Org id
      --format <format> mandatory=false default=table :: Output format: json|table
  sandbox-allowlist :: Manage the per-org container-sandbox escape-hatch allow-list (empty = deny all)
    show :: Print the current per-org sandbox capability + host-network allow-list
      --org <id> mandatory=true :: Org id
      --format <format> mandatory=false default=table :: Output format: json|table
    set-capabilities :: Set the allowed capabilities (comma-separated, e.g. NET_ADMIN,SYS_PTRACE; empty clears)
      arg capabilities required=true :: 
      --org <id> mandatory=true :: Org id
      --format <format> mandatory=false default=table :: Output format: json|table
    allow-host-network :: Allow (true) or deny (false) workflow-requested host networking
      arg value required=true :: 
      --org <id> mandatory=true :: Org id
      --format <format> mandatory=false default=table :: Output format: json|table
    reset :: Clear the allow-list (deny all capabilities and host networking)
      --org <id> mandatory=true :: Org id
      --format <format> mandatory=false default=table :: Output format: json|table
  reroute :: Manage the per-org cross-peer reroute tunables (null = cluster default)
    show :: Print the current per-org reroute tunables
      --org <id> mandatory=true :: Org id
      --format <format> mandatory=false default=table :: Output format: json|table
    set :: Set one or more reroute tunables. At least one of --window / --ack-timeout / --max-hops / --spawn-max-attempts / --spawn-retry-backoff.
      --org <id> mandatory=true :: Org id
      --window <ms> mandatory=false :: Spawn window (integer milliseconds, >= 1000)
      --ack-timeout <ms> mandatory=false :: Reroute ACK timeout (integer milliseconds, >= 1000)
      --max-hops <n> mandatory=false :: Maximum peer hops (integer >= 1)
      --spawn-max-attempts <n> mandatory=false :: Spawn attempts a worker makes for one rerouted job (integer >= 1)
      --spawn-retry-backoff <ms> mandatory=false :: Wait after a failed spawn before the next attempt (integer milliseconds, >= 0)
      --format <format> mandatory=false default=table :: Output format: json|table
    reset :: Clear every per-org reroute override (fall back to the cluster defaults)
      --org <id> mandatory=true :: Org id
      --format <format> mandatory=false default=table :: Output format: json|table
  backup-freshness :: Manage the per-org DB-backup freshness WARN threshold (null = cluster default)
    show :: Print the current per-org backup-freshness threshold
      --org <id> mandatory=true :: Org id
      --format <format> mandatory=false default=table :: Output format: json|table
    set :: Set the per-org backup-freshness WARN threshold in hours (>= 1)
      --hours <n> mandatory=true :: Threshold in hours (integer >= 1)
      --org <id> mandatory=true :: Org id
      --format <format> mandatory=false default=table :: Output format: json|table
    reset :: Clear the per-org override (fall back to the cluster default)
      --org <id> mandatory=true :: Org id
      --format <format> mandatory=false default=table :: Output format: json|table
  queue-timeout :: Manage the per-org dispatch-queue job timeout (null = cluster default)
    show :: Print the current per-org queue timeout
      --org <id> mandatory=true :: Org id
      --format <format> mandatory=false default=table :: Output format: json|table
    set :: Set the per-org queue timeout in milliseconds (0 = indefinite)
      arg ms required=true :: Queue timeout in milliseconds (integer >= 0)
      --org <id> mandatory=true :: Org id
      --format <format> mandatory=false default=table :: Output format: json|table
    reset :: Clear the per-org queue-timeout override (fall back to the cluster default)
      --org <id> mandatory=true :: Org id
      --format <format> mandatory=false default=table :: Output format: json|table
  cache-upload-settle :: Manage how long a build success waits for its cache upload to publish (null = cluster default)
    show :: Print the current per-org cache upload settle timeout
      --org <id> mandatory=true :: Org id
      --format <format> mandatory=false default=table :: Output format: json|table
    set :: Set the per-org cache upload settle timeout in milliseconds (0 = no wait)
      arg ms required=true :: Settle timeout in milliseconds (integer >= 0)
      --org <id> mandatory=true :: Org id
      --format <format> mandatory=false default=table :: Output format: json|table
    reset :: Clear the per-org cache upload settle override (fall back to the cluster default)
      --org <id> mandatory=true :: Org id
      --format <format> mandatory=false default=table :: Output format: json|table
  approval :: Manage the per-org held-approval expiry + self-approval policy
    show :: Print the current per-org approval policy
      --org <id> mandatory=true :: Org id
      --format <format> mandatory=false default=table :: Output format: json|table
    set-expiry :: Set the per-org held-approval expiry (integer seconds, >= 1)
      arg seconds required=true :: 
      --org <id> mandatory=true :: Org id
      --format <format> mandatory=false default=table :: Output format: json|table
    set-self-approval :: Allow or forbid a run triggerer approving its own held elements (true|false)
      arg value required=true :: 
      --org <id> mandatory=true :: Org id
      --format <format> mandatory=false default=table :: Output format: json|table"
`;

exports[`org-settings help pin > org-settings --help is unchanged 1`] = `
"Usage: kici-admin org-settings [options] [command]

Manage org-level security settings

Options:
  -h, --help                                           display help for command

Commands:
  global-workflows                                     Manage per-org global workflow policy
  dashboard-writes                                     Manage per-orch dashboard write policy (which
                                                       Platform-routed dashboard.* writes the orch
                                                       accepts)
  allow-http-npm [options] <value>                     Permit plain http:// npm registry URLs in
                                                       workflow registries:. Default false; loopback
                                                       / *.local are always allowed regardless.
  allow-untrusted-dockerfile-builds [options] <value>  Permit an untrusted ref (fork PR) to build a
                                                       job's container image from a Dockerfile.
                                                       Default false. The build is NOT sandboxed —
                                                       it runs arbitrary RUN commands on the agent
                                                       host's container daemon.
  user-cache                                           Manage per-org user-facing cache quota +
                                                       entry TTL (null = cluster default)
  artifacts                                            Manage per-org artifact quota / TTL / size
                                                       cap / per-run cap (null = cluster default)
  dispatch-ack                                         Manage the per-org dispatch-acknowledgment
                                                       deadline (null = cluster default)
  scaler-spawn-timeout                                 Manage the per-org scaler spawn deadline
                                                       (null = cluster default)
  ingest-concurrency                                   Manage the per-org webhook-ingest concurrency
                                                       cap (null = cluster default)
  sandbox-allowlist                                    Manage the per-org container-sandbox
                                                       escape-hatch allow-list (empty = deny all)
  reroute                                              Manage the per-org cross-peer reroute
                                                       tunables (null = cluster default)
  backup-freshness                                     Manage the per-org DB-backup freshness WARN
                                                       threshold (null = cluster default)
  queue-timeout                                        Manage the per-org dispatch-queue job timeout
                                                       (null = cluster default)
  cache-upload-settle                                  Manage how long a build success waits for its
                                                       cache upload to publish (null = cluster
                                                       default)
  approval                                             Manage the per-org held-approval expiry +
                                                       self-approval policy
  help [command]                                       display help for command
"
`;

exports[`org-settings help pin > org-settings allow-http-npm --help is unchanged 1`] = `
"Usage: kici-admin org-settings allow-http-npm [options] <value>

Permit plain http:// npm registry URLs in workflow registries:. Default false; loopback / *.local
are always allowed regardless.

Options:
  --org <id>         Org id
  --format <format>  Output format: json|table (default: "table")
  -h, --help         display help for command
"
`;

exports[`org-settings help pin > org-settings allow-untrusted-dockerfile-builds --help is unchanged 1`] = `
